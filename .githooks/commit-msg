#!/usr/bin/env node
/**
 * Strip Cursor co-author / Made-with trailers from the commit message file.
 * Usage: commit-msg <path-to-message-file>
 */
const fs = require("fs");

const file = process.argv[2];
if (!file || !fs.existsSync(file)) {
  process.exit(0);
}

let msg = fs.readFileSync(file, "utf8");
const cleaned = msg
  .split(/\r?\n/)
  .filter((line) => {
    const t = line.trim();
    if (/^Co-authored-by:.*Cursor/i.test(t)) return false;
    if (/^Co-authored-by:.*cursoragent@cursor\.com/i.test(t)) return false;
    if (/^Made-with:\s*Cursor/i.test(t)) return false;
    return true;
  })
  .join("\n")
  .replace(/\n{3,}/g, "\n\n")
  .replace(/[ \t]+\n/g, "\n")
  .replace(/\s+$/g, "\n");

if (cleaned !== msg) {
  fs.writeFileSync(file, cleaned);
}
